server:
  listen_addr: 127.0.0.1:8080

database:
  host: 127.0.0.1
  port: 3306
  username: whisper
  password: ""
  name: whisper
  charset: utf8mb4
  parse_time: true
  loc: Local
  timeout: 5s
  read_timeout: 5s
  write_timeout: 5s
  pool:
    max_open_conns: 50
    max_idle_conns: 10
    conn_max_lifetime: 1h
    conn_max_idle_time: 30m

redis:
  host: 127.0.0.1
  port: 6379
  username: ""
  password: ""
  db: 0
  dial_timeout: 5s
  read_timeout: 3s
  write_timeout: 3s
  pool:
    pool_size: 20
    min_idle_conns: 2
    max_idle_conns: 10
    max_active_conns: 0
    pool_timeout: 4s
    conn_max_idle_time: 30m
    conn_max_lifetime: 0s

auth:
  jwt_secret: ""
  access_token_ttl: 15m
  refresh_token_ttl: 720h

cors:
  allowed_origins:
    - http://127.0.0.1:1420
    - http://tauri.localhost

seed:
  account: ""
  password: ""
