server:
  listen_addr: 127.0.0.1:8080

database:
  host: 127.0.0.1
  port: 3306
  username: whisper
  password: ""
  name: whisper_test
  charset: utf8mb4
  parse_time: true
  loc: Local
  timeout: 5s
  read_timeout: 5s
  write_timeout: 5s
  pool:
    max_open_conns: 10
    max_idle_conns: 2
    conn_max_lifetime: 1h
    conn_max_idle_time: 30m

redis:
  host: 127.0.0.1
  port: 6379
  username: ""
  password: ""
  db: 1
  dial_timeout: 5s
  read_timeout: 3s
  write_timeout: 3s
  pool:
    pool_size: 10
    min_idle_conns: 1
    max_idle_conns: 2
    max_active_conns: 0
    pool_timeout: 4s
    conn_max_idle_time: 30m
    conn_max_lifetime: 0s

auth:
  jwt_secret: test-secret
  access_token_ttl: 15m
  refresh_token_ttl: 720h

storage:
  endpoint: http://127.0.0.1:9000
  region: us-east-1
  bucket_name: whisper-test
  access_key_id: test-access-key
  secret_access_key: test-secret-key
  force_path_style: true
  object_prefix: avatars/
  upload_url_ttl: 10m
  download_url_ttl: 5m

chat_rpc_secret: test-chat-rpc-secret

cors:
  allowed_origins:
    - http://127.0.0.1:1420

seed:
  users:
    - account: "00100001"
      password: "password"
    - account: "00100002"
      password: "password"
